{
  "expo": {
    "name": "DexWish",
    "slug": "dexwish",
    "scheme": "dexwish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1B1B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dexwish.app"
    },
    "android": {
      "package": "com.dexwish.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1B1B"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O DexWish precisa acessar suas fotos para você escolher a imagem do desejo e do perfil.",
          "cameraPermission": "O DexWish precisa da câmera para você fotografar o desejo ou a foto de perfil."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
